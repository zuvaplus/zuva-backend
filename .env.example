# ── Database ──────────────────────────────────────────────────
# Supabase connection string (or any PostgreSQL URL)
DATABASE_URL=postgresql://user:password@host:5432/zuva

# ── Chimoney payments ─────────────────────────────────────────
CHIMONEY_API_KEY=your_chimoney_api_key_here
CHIMONEY_BASE_URL=https://api.chimoney.io/v0.2

# ── Platform config ───────────────────────────────────────────
# UUID of the platform's internal wallet (must exist in the wallets table)
PLATFORM_WALLET_ID=00000000-0000-0000-0000-000000000001

# Frontend URL — used in Chimoney payment redirect links
APP_URL=https://your-frontend.up.railway.app

# JWT secret — use a long random string in production
JWT_SECRET=change_this_to_a_long_random_string

# ── Railway sets PORT automatically — do not override ─────────
# PORT=3000

# ── Cloudflare Turnstile (bot protection on Creator Sign-Up) ────
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# ── Admin dashboard (temporary header-based check — see requireAdmin
# in zuva-api.js for why this needs replacing with real session auth
# before production) ─────────────────────────────────────────────
ADMIN_EMAIL=your_admin_email@zuva.tv

# ── Cloudflare Stream (video upload) ─────────────────────────────
# Account ID: Cloudflare dashboard → Stream → right sidebar.
# API token: My Profile → API Tokens → Create Token → "Edit Cloudflare Stream" template.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_stream_api_token

# ── AWS Rekognition (video content moderation) ────────────────────
# IAM user needs rekognition:DetectModerationLabels permission only.
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
